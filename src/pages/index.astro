---
const WHATSAPP_NUMBER = '201090422816';
const WHATSAPP_TEXT_DEFAULT = 'أهلاً أستاذة أميمة، حابب/ة أعرف تفاصيل الدروس.';
const WHATSAPP_LINK = `https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent(WHATSAPP_TEXT_DEFAULT)}`;
const CONTACT_EMAIL = 'omima@omimaramadan.com';

const GOVERNORATES = ['أسيوط', 'سوهاج', 'أسوان', 'بني سويف', 'قنا', 'المنيا', 'القاهرة', 'محافظة أخرى'];
const GRADES = ['الصف الأول الثانوي', 'الصف الثاني الثانوي', 'الصف الثالث الثانوي'];
---

<!doctype html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>أميمة رمضان | أحياء الثانوية — مجموعات أونلاين على Zoom</title>
  <meta name="description" content="كورس أحياء لجميع طلاب المرحلة الثانوية في مجموعات أونلاين مباشرة على Zoom مع الأستاذة أميمة رمضان — خبرة أكثر من 35 سنة، شرح مبني على الفهم ومتابعة مباشرة للأسئلة." />
  <meta name="theme-color" content="#0b121c" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

  <meta property="og:title" content="أميمة رمضان | أحياء الثانوية — مجموعات أونلاين على Zoom" />
  <meta property="og:description" content="كورس أحياء لجميع طلاب الثانوية في مجموعات أونلاين مباشرة على Zoom — خبرة أكثر من 35 سنة، شرح مبني على الفهم." />
  <meta property="og:image" content="/logo.png" />
  <meta property="og:type" content="website" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Aref+Ruqaa:wght@400;700&family=IBM+Plex+Sans+Arabic:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
</head>
<body>

  <header class="topbar">
    <div class="wrap topbar-inner">
      <img class="brand-mark" src="/logo.png" alt="أميمة رمضان - معلمة الأحياء" />
      <a class="btn btn-ghost btn-sm" href={WHATSAPP_LINK} target="_blank" rel="noopener">
        <svg class="icon" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M17.6 6.3A8.4 8.4 0 0 0 4 16.4L3 21l4.7-1.2A8.4 8.4 0 1 0 17.6 6.3Z" stroke="currentColor" stroke-width="1.5"/><path d="M9 9.6c0 3.6 2.9 6.4 6.4 6.4.5 0 .9-.5.7-1l-.6-1.3a.8.8 0 0 0-.9-.4l-1 .3a4.6 4.6 0 0 1-2.7-2.7l.3-1a.8.8 0 0 0-.4-.9L9.5 8.3c-.5-.2-1 .2-1 .7Z" fill="currentColor"/></svg>
        واتساب
      </a>
    </div>
  </header>

  <main>
    <!-- HERO -->
    <section class="hero">
      <div class="hero-glow" aria-hidden="true"></div>
      <div class="wrap hero-inner">
        <p class="eyebrow">الأستاذة أميمة رمضان</p>
        <h1 class="display">الأحياء مش مادة حفظ —<br/>لما تفهمها، تفتكرها</h1>
        <p class="lede">
          لو بتذاكر الباب كويس وتنساه بعد أسبوع، وبتخاف من أسئلة <em>"علل"</em> و<em>"المقالي"</em> —
          المشكلة مش في مجهودك، في طريقة الشرح. كورس أحياء لجميع طلاب الثانوية،
          في <em>مجموعات أونلاين مباشرة على Zoom</em>، بيشرح <em>ليه</em> قبل <em>إزاي</em>،
          ومعاه متابعة لأسئلتك بعد كل حصة.
        </p>
        <div class="hero-actions">
          <a href="#form" class="btn btn-primary btn-lg">احجز مكانك الآن</a>
          <a href={WHATSAPP_LINK} target="_blank" rel="noopener" class="btn btn-outline btn-lg">تواصل عبر واتساب</a>
        </div>
        <dl class="stats">
          <div class="stat">
            <dt>+35</dt>
            <dd>سنة خبرة في تدريس الأحياء</dd>
          </div>
          <div class="stat">
            <dt>+30</dt>
            <dd>دفعة تخرجت على يديها</dd>
          </div>
          <div class="stat">
            <dt>Zoom</dt>
            <dd>كل الحصص أونلاين مباشر</dd>
          </div>
        </dl>
      </div>
    </section>

    <!-- PAINS -->
    <section class="section">
      <div class="wrap pain-wrap">
        <p class="section-eyebrow">قبل ما نبدأ</p>
        <h2 class="section-title">لو أي نقطة من دول بتوصفك… إنت في المكان الصح</h2>
        <ul class="pain-list">
          <li>بتذاكر الباب كويس، وبعد أسبوع كإنك ما ذاكرتش.</li>
          <li>بتحفظ المعلومة من غير ما تعرف جايه منين ولا بتأدّي لإيه.</li>
          <li>أسئلة «علل» و«قارن» والمقالي بتوقّفك، مع إنك مذاكر.</li>
          <li>عندك أسئلة كتير ومفيش حد بيجاوب عليها بجدية.</li>
          <li>المنهج كبير ومش عارف تبدأ منين ولا تظبّط وقتك إزاي.</li>
        </ul>
        <p class="pain-note">ده مش ضعف منك — ده نتيجة إنك بتذاكر الأحياء بالطريقة الغلط.</p>
      </div>
    </section>

    <!-- REFRAME -->
    <section class="section section-alt">
      <div class="wrap about-wrap">
        <p class="section-eyebrow">ليه بيحصل ده</p>
        <h2 class="section-title">الحفظ بيتعب أكتر… وبيتنسى أسرع</h2>
        <div class="about-body">
          <p>
            المعلومة اللي بتيجي من غير سبب، الدماغ بترميها بسرعة — خصوصًا وقت ضغط الامتحان.
            لكن لما تفهم <strong>ليه</strong> الحاجة بتحصل، المعلومة بتترتّب لوحدها وتفضل معاك،
            وتقدر تطلّعها في أي صيغة سؤال.
          </p>
          <p>
            ده أساس الكورس: كل معلومة ليها سبب، وكل سبب بيربطك بالباقي — فبدل ما تحفظ مئات النقاط
            المنفصلة، بتفهم <strong>شبكة واحدة</strong> مترابطة.
          </p>
        </div>
      </div>
    </section>

    <!-- METHOD -->
    <section class="section">
      <div class="wrap">
        <p class="section-eyebrow">أسلوب الكورس</p>
        <h2 class="section-title">مش مجرد شرح — طريقة مذاكرة كاملة</h2>
        <div class="cards">
          <article class="card">
            <span class="card-num">01</span>
            <h3>شرح بالمنطق مش بالحفظ</h3>
            <p>
              مثلاً في الهرمونات: مش هتحفظ الاسم وخلاص — هتفهم ليه الهرمون الستيرويدي (زي الكورتيزول)
              بيتكوّن من الكوليسترول مش من البروتين، وإزاي ده بيغيّر شكل السؤال في الامتحان.
            </p>
          </article>
          <article class="card">
            <span class="card-num">02</span>
            <h3>متابعة حقيقية لأسئلتك</h3>
            <p>
              بعد كل حصة، تبعت سؤالك على واتساب ويترد عليه بالتفصيل — مش رسالة عامة، إجابة مخصوصة
              على النقطة اللي فعلاً محيّراك.
            </p>
          </article>
          <article class="card">
            <span class="card-num">03</span>
            <h3>ملخصات ونقاط «لازم تفتكرها»</h3>
            <p>
              قبل كل امتحان، ملخصات مركّزة ونقاط سريعة — زي فرق اتجاه القراءة بين الـ mRNA والـ tRNA —
              في صورة سهلة إنك تفتكرها وقت الضغط.
            </p>
          </article>
        </div>
      </div>
    </section>

    <!-- ABOUT -->
    <section class="section section-alt">
      <div class="wrap about-wrap">
        <p class="section-eyebrow">مين اللي هيشرحلك</p>
        <h2 class="section-title">أكثر من 35 سنة في تدريس الأحياء للثانوية</h2>
        <div class="about-body">
          <p>
            الأستاذة أميمة رمضان، معلمة الأحياء للمرحلة الثانوية بخبرة تزيد على <strong>35 سنة</strong>
            في التربية والتعليم، وتدرّجت في المهنة حتى وصلت إلى <strong>كبير معلمين</strong> لمادة الأحياء.
          </p>
          <p>
            تُدرّس الأحياء منذ <strong>سبتمبر 1983</strong>، وتخرّج على يديها أكثر من <strong>30 دفعة</strong> —
            أغلبهم من المتفوقين الذين التحقوا بكليات متميزة، بفضل الله ثم بجهدهم المستمر
            واستماعهم لتوجيهات معلميهم واهتمامهم الدائم.
          </p>
        </div>
        <blockquote class="about-quote">
          <p>
            عزيزي طالب الثانوية العامة، لقد اجتهدت ووصلت إلى مرحلة مهمة في حياتك، فأنت متميز إذ وصلت لهذه المرحلة.
            وهبك الله الفطنة والدقة والنظام، وهذا ما لمسته خلال عملي الطويل في هذه المرحلة.
            فحافظ على الإنجاز الكبير الذي بين يديك بالمذاكرة والمثابرة الدائمة، وبإذن الله سأساعدك
            في فهم مادة الأحياء والحصول على أعلى الدرجات. بالتوفيق…
          </p>
          <cite>— أ. أميمة رمضان</cite>
        </blockquote>
      </div>
    </section>

    <!-- LOGISTICS -->
    <section class="section">
      <div class="wrap">
        <p class="section-eyebrow">إزاي بتتم الحصص</p>
        <h2 class="section-title">مجموعات أونلاين مباشرة على Zoom</h2>
        <div class="format-grid">
          <div class="format-card">
            <h3>لكل الصفوف</h3>
            <p>مجموعات للصف الأول والثاني والثالث الثانوي — لجميع الطلاب، كل صف في مجموعته المناسبة.</p>
          </div>
          <div class="format-card">
            <h3>من أي مكان</h3>
            <p>مش محتاج تنتقل لأي حتة — كل اللي محتاجه موبايل أو لابتوب واتصال إنترنت، وتحضر الحصة من البيت.</p>
          </div>
          <div class="format-card">
            <h3>مباشر وتفاعل</h3>
            <p>الحصص في مجموعات مباشرة (Live) على Zoom — تقدر تسأل وتشارك أثناء الشرح، مش مجرد فيديو مسجّل.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="section section-alt">
      <div class="wrap faq-wrap">
        <p class="section-eyebrow">أسئلة سريعة</p>
        <h2 class="section-title">لسه متردد؟ خد بالك من دول</h2>
        <div class="faq">
          <details>
            <summary>الكورس لمين بالظبط؟</summary>
            <p>لجميع طلاب الثانوية — بنين وبنات، الصف الأول والثاني والثالث، كل صف في مجموعته.</p>
          </details>
          <details>
            <summary>الحصص مباشرة ولا مسجلة؟</summary>
            <p>كلها مباشرة (Live) في مجموعات على Zoom، عشان تقدر تسأل وتتفاعل وقت الشرح مش بعده.</p>
          </details>
          <details>
            <summary>لو عندي سؤال بعد الحصة؟</summary>
            <p>تبعته على واتساب ويترد عليه بالتفصيل — إجابة مخصوصة على سؤالك، مش رسالة عامة.</p>
          </details>
          <details>
            <summary>أنا مش في نفس محافظة الأستاذة، أقدر أشترك؟</summary>
            <p>طبعًا. الكورس كله أونلاين، محتاج بس نت وموبايل أو لابتوب.</p>
          </details>
          <details>
            <summary>إزاي أحجز وأعرف المواعيد والاشتراك؟</summary>
            <p>املا البيانات تحت، هيفتحلك واتساب على طول ونكمّل معاك تفاصيل المجموعة والمواعيد والاشتراك ونأكد الحجز.</p>
          </details>
        </div>
      </div>
    </section>

    <!-- FORM -->
    <section class="section" id="form">
      <div class="wrap form-wrap">
        <p class="section-eyebrow">الخطوة الأخيرة</p>
        <h2 class="section-title">احجز مكانك في مجموعة الأحياء</h2>
        <p class="section-sub">سجّل بياناتك، هيفتحلك واتساب على طول نكمّل باقي التفاصيل ونأكد الحجز.</p>

        <form id="lead-form" class="lead-form" novalidate>
          <div class="field">
            <label for="name">الاسم بالكامل</label>
            <input id="name" name="name" type="text" required autocomplete="name" placeholder="مثال: محمد أحمد" />
          </div>

          <div class="field-row">
            <div class="field">
              <label for="phone">رقم موبايلك</label>
              <input id="phone" name="phone" type="tel" required autocomplete="tel" placeholder="01xxxxxxxxx" />
            </div>
            <div class="field">
              <label for="guardianPhone">رقم موبايل ولي الأمر <span class="optional">(اختياري)</span></label>
              <input id="guardianPhone" name="guardianPhone" type="tel" autocomplete="tel" placeholder="01xxxxxxxxx" />
            </div>
          </div>

          <div class="field-row">
            <div class="field">
              <label for="grade">الصف الدراسي</label>
              <select id="grade" name="grade" required>
                <option value="" disabled selected>اختر الصف</option>
                {GRADES.map((g) => <option value={g}>{g}</option>)}
              </select>
            </div>
            <div class="field">
              <label for="governorate">المحافظة <span class="optional">(اختياري)</span></label>
              <select id="governorate" name="governorate">
                <option value="" selected>اختر المحافظة</option>
                {GOVERNORATES.map((g) => <option value={g}>{g}</option>)}
              </select>
            </div>
          </div>

          <p class="form-note">كل الحصص في مجموعات أونلاين مباشرة على Zoom — هيوصلك رابط الحضور على واتساب.</p>

          <button type="submit" class="btn btn-primary btn-lg btn-block">
            <span class="btn-label">إرسال والانضمام عبر واتساب</span>
          </button>
          <p id="form-error" class="form-error" role="alert" hidden></p>
        </form>

        <div id="form-success" class="form-success" hidden>
          <h3>تم استلام بياناتك ✓</h3>
          <p>دوس على الزرار عشان تكمّل التفاصيل مع الأستاذة أميمة مباشرة على واتساب.</p>
          <a id="whatsapp-cta" class="btn btn-primary btn-lg" href={WHATSAPP_LINK} target="_blank" rel="noopener">فتح واتساب</a>
        </div>
      </div>
    </section>
  </main>

  <footer class="footer">
    <div class="wrap footer-inner">
      <img class="brand-mark brand-mark-sm" src="/logo.png" alt="أميمة رمضان - معلمة الأحياء" />
      <div class="footer-links">
        <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
        <a href={WHATSAPP_LINK} target="_blank" rel="noopener">واتساب</a>
      </div>
      <p class="footer-copy">© {new Date().getFullYear()} أميمة رمضان — جميع الحقوق محفوظة</p>
    </div>
  </footer>

  <script define:vars={{ WHATSAPP_NUMBER }}>
    const form = document.getElementById('lead-form');
    const errorEl = document.getElementById('form-error');
    const successEl = document.getElementById('form-success');
    const whatsappCta = document.getElementById('whatsapp-cta');

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      errorEl.hidden = true;

      const data = Object.fromEntries(new FormData(form).entries());
      const submitBtn = form.querySelector('button[type="submit"]');
      submitBtn.disabled = true;

      try {
        const res = await fetch('/api/lead', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify(data),
        });
        const result = await res.json();
        if (!res.ok || !result.ok) throw new Error(result.error || 'submit_failed');

        const place = data.governorate ? ` - ${data.governorate}` : '';
        const text = `أهلاً أستاذة أميمة، اسمي ${data.name} (${data.grade || ''}${place}) وحابب/ة أنضم لمجموعة الأحياء أونلاين على Zoom.`;
        whatsappCta.href = `https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent(text)}`;

        form.hidden = true;
        successEl.hidden = false;
        successEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
      } catch (err) {
        errorEl.textContent = 'حصلت مشكلة في الإرسال، حاولي تاني أو تواصلي معنا مباشرة على واتساب.';
        errorEl.hidden = false;
      } finally {
        submitBtn.disabled = false;
      }
    });
  </script>

</body>
</html>

<style>
  :root {
    --bg: #0b121c;
    --bg-panel: #121b28;
    --bg-panel-2: #17222f;
    --ink: #eef3f1;
    --muted: #9fb0c3;
    --border: rgba(238, 243, 241, 0.1);
    --accent: #35b686;
    --accent-ink: #052015;
    --accent-2: #f0a94e;
    --accent-2-ink: #241300;
    --radius: 14px;
    --font-display: 'Aref Ruqaa', 'Traditional Arabic', serif;
    --font-body: 'IBM Plex Sans Arabic', 'Segoe UI', Tahoma, sans-serif;
  }

  * { box-sizing: border-box; }

  html { scroll-behavior: smooth; }
  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
    * { animation: none !important; transition: none !important; }
  }

  body {
    margin: 0;
    background: var(--bg);
    color: var(--ink);
    font-family: var(--font-body);
    line-height: 1.65;
    -webkit-font-smoothing: antialiased;
  }

  .wrap {
    width: 100%;
    max-width: 1080px;
    margin-inline: auto;
    padding-inline: clamp(1.25rem, 4vw, 2.5rem);
  }

  img { max-width: 100%; display: block; }

  /* Topbar */
  .topbar {
    position: sticky;
    top: 0;
    z-index: 20;
    background: rgba(11, 18, 28, 0.85);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--border);
  }
  .topbar-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: 0.75rem;
  }
  .brand-mark { height: 34px; width: auto; }
  .brand-mark-sm { height: 40px; }

  /* Buttons */
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    font-family: var(--font-body);
    font-weight: 600;
    text-decoration: none;
    border-radius: 999px;
    border: 1px solid transparent;
    cursor: pointer;
    transition: transform 0.15s ease, background-color 0.15s ease, border-color 0.15s ease;
    white-space: nowrap;
  }
  .btn:focus-visible {
    outline: 2px solid var(--accent-2);
    outline-offset: 3px;
  }
  .btn-sm { padding: 0.45rem 1rem; font-size: 0.85rem; }
  .btn-lg { padding: 0.85rem 1.75rem; font-size: 1rem; }
  .btn-block { width: 100%; }
  .btn-primary {
    background: var(--accent);
    color: var(--accent-ink);
  }
  .btn-primary:hover { transform: translateY(-1px); }
  .btn-outline {
    background: transparent;
    border-color: var(--border);
    color: var(--ink);
  }
  .btn-outline:hover { border-color: var(--accent); color: var(--accent); }
  .btn-ghost {
    background: rgba(53, 182, 134, 0.12);
    color: var(--accent);
  }
  .icon { width: 1rem; height: 1rem; }

  /* Hero */
  .hero {
    position: relative;
    padding-block: clamp(3rem, 8vw, 6rem) clamp(2.5rem, 6vw, 4rem);
    overflow: clip;
  }
  .hero-glow {
    position: absolute;
    inset: -20% -10% auto -10%;
    height: 60%;
    background: radial-gradient(60% 60% at 30% 20%, rgba(53, 182, 134, 0.25), transparent 70%),
                radial-gradient(50% 50% at 80% 10%, rgba(240, 169, 78, 0.16), transparent 70%);
    pointer-events: none;
  }
  .hero-inner { position: relative; }
  .eyebrow {
    color: var(--accent);
    font-weight: 600;
    letter-spacing: 0.02em;
    margin: 0 0 0.75rem;
